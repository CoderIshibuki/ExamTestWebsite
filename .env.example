# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=exam_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MongoDB
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=mongo
MONGO_URI=mongodb://mongo:mongo@mongodb:27017/exam_db?authSource=admin

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Auth Service
AUTH_PORT=8000
JWT_SECRET=supersecretkey
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
